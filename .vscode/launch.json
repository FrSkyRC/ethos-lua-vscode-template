{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Deploy & Launch [SIM]",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true,
      "stopOnEntry": false,
      "preLaunchTask": "Deploy & Launch [SIM]",
      "postDebugTask": "ethos.Start"
    },
    {
      "name": "Deploy Radio",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true,
      "stopOnEntry": false,
      "preLaunchTask": "Deploy Radio"
    },
    {
      "name": "Deploy Radio [Fast]",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true,
      "stopOnEntry": false,
      "preLaunchTask": "Deploy Radio [Fast]"
    },
    {
      "name": "Deploy Radio + Serial Debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true,
      "stopOnEntry": false,
      "preLaunchTask": "Deploy Radio + Serial Debug"
    },
    {
      "name": "Deploy Radio + Serial Debug [Fast]",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true,
      "stopOnEntry": false,
      "preLaunchTask": "Deploy Radio + Serial Debug [Fast]"
    },
    {
      "name": "Radio: Serial Debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true,
      "stopOnEntry": false,
      "preLaunchTask": "Radio: Serial Debug"
    },
    {
      "name": "Simulator: Set Simulator",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true,
      "stopOnEntry": false,
      "preLaunchTask": "ethos.SetSimulator"
    },
    {
      "name": "Simulator: Open Controls",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true,
      "stopOnEntry": false,
      "preLaunchTask": "ethos.OpenControls"
    },
    {
      "name": "Simulator: Open Telemetry",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true,
      "stopOnEntry": false,
      "preLaunchTask": "ethos.OpenTelemetry"
    },
    {
      "name": "Set Deployment Language",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/set_language.py",
      "args": [
        "${input:deployLanguage}"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Package: Build Zip [current language]",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Package: Build Zip [current language]"
    },
    {
      "name": "Package: Build Zips [all languages]",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Package: Build Zips [all languages]"
    },
    {
      "name": "Debug Radio Connection",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Debug Radio Connection"
    },
    {
      "name": "Clear locks",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/scripts/dummy.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Clear locks"
    }
  ],
  "inputs": [
    {
      "id": "deployLanguage",
      "type": "pickString",
      "description": "Select deployment language (keep in sync with i18n/*.json)",
      "options": [
        "en",
        "de"
      ],
      "default": "en"
    }
  ]
}
